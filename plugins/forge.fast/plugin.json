{
  "schemaVersion": 1,
  "apiVersion": 3,
  "version": "0.4.2",
  "compatibility": {
    "codex": [
      "26.1027.6604.0",
      "26.1027.3384.0",
      "26.1023.6123.0",
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.4.0 <0.5.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "settings",
      "version": 1
    }
  ],
  "changelog": [
    {
      "version": "0.4.2",
      "date": "2026-11-04",
      "items": [
        "随 Forge 0.4.2 更新，支持 ZIP/7z 插件安装、左栏图标及可选隔离脚本权限。"
      ]
    },
    {
      "version": "0.4.1",
      "date": "2026-11-04",
      "items": [
        "随 Forge 0.4.1 发布，保持 API 3；Nexus 改为独立导入的外部插件。"
      ]
    },
    {
      "version": "0.4.0",
      "date": "2026-11-04",
      "items": [
        "升级至 Codex Forge 0.4.0 / Forge API 3，支持增量能力协商和结构化错误。"
      ]
    },
    {
      "version": "0.3.4",
      "date": "2026-11-04",
      "items": [
        "兼容官方客户端 26.1027.6604.0，更新主页面、设置页及 Fast 适配器。",
        "随 Codex Forge 0.3.4 发布，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.3",
      "date": "2026-11-03",
      "items": [
        "新增模型显示控制与 GPT-6.1-Terra / Fast 开关；保存后重启生效。"
      ]
    },
    {
      "version": "0.3.2",
      "date": "2026-11-01",
      "items": [
        "适配 Codex 26.1027.3384.0，保持 Forge API 2；修复主页面入口需要先进入设置的问题。"
      ]
    },
    {
      "version": "0.3.1",
      "date": "2026-10-28",
      "items": [
        "适配 Codex 26.1023.6123.0，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-27",
      "items": [
        "升级至 Codex Forge 0.3.0 / Forge API 2。"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-24",
      "items": [
        "适配新客户端渲染器的 Fast 补丁锚点；补丁集改为适配器显式声明，锚点不匹配时构建失败。"
      ]
    }
  ],
  "id": "forge.fast",
  "name": "Fast 与模型配置",
  "description": "原生模型显示控制、GPT-6.1-Terra 与 Fast 支持；设置统一保存，重启后生效。",
  "contributes": {
    "settings": {
      "properties": {
        "defaultSpeed": {
          "type": "string",
          "title": "默认速度（仅 Forge 启动参数）",
          "enum": [
            "native",
            "fast"
          ],
          "default": "fast"
        },
        "enableTerra": {
          "type": "boolean",
          "title": "启用 GPT-6.1-Terra 模型与 Fast 支持",
          "default": true
        },
        "hiddenModels": {
          "type": "array",
          "title": "隐藏的模型",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 200,
          "default": []
        }
      }
    }
  },
  "restartRequired": true
}
