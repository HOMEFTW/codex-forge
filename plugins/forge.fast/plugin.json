{
  "schemaVersion": 1,
  "apiVersion": 1,
  "version": "0.2.0",
  "compatibility": {
    "codex": [
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.2.0 <0.3.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "changelog": [
    {
      "version": "0.2.0",
      "date": "2026-10-24",
      "items": [
        "作为 Codex Forge 内置插件提供，继承 r4 修订3 已有能力。"
      ]
    }
  ],
  "id": "forge.fast",
  "name": "Fast 与模型配置",
  "description": "API Key/自定义提供商的 Fast 能力；保持模型、提供商及上下文目录配置。",
  "contributes": {
    "settings": {
      "properties": {
        "defaultSpeed": {
          "type": "string",
          "title": "默认速度（仅 Forge 启动参数）",
          "enum": [
            "native",
            "fast"
          ],
          "default": "fast"
        }
      }
    }
  },
  "restartRequired": true
}
