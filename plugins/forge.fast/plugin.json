{
  "schemaVersion": 1,
  "apiVersion": 2,
  "version": "0.3.1",
  "compatibility": {
    "codex": [
      "26.1023.6123.0",
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.3.0 <0.4.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "settings",
      "version": 1
    }
  ],
  "changelog": [
    {
      "version": "0.3.1",
      "date": "2026-10-28",
      "items": [
        "适配 Codex 26.1023.6123.0，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-27",
      "items": [
        "升级至 Codex Forge 0.3.0 / Forge API 2。"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-24",
      "items": [
        "适配新客户端渲染器的 Fast 补丁锚点；补丁集改为适配器显式声明，锚点不匹配时构建失败。"
      ]
    }
  ],
  "id": "forge.fast",
  "name": "Fast 与模型配置",
  "description": "API Key/自定义提供商的 Fast 能力；保持模型、提供商及上下文目录配置。",
  "contributes": {
    "settings": {
      "properties": {
        "defaultSpeed": {
          "type": "string",
          "title": "默认速度（仅 Forge 启动参数）",
          "enum": [
            "native",
            "fast"
          ],
          "default": "fast"
        }
      }
    }
  },
  "restartRequired": true
}
