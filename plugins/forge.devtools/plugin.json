{
  "schemaVersion": 1,
  "apiVersion": 3,
  "version": "0.4.2",
  "compatibility": {
    "codex": [
      "26.1027.6604.0",
      "26.1027.3384.0",
      "26.1023.6123.0",
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.4.0 <0.5.0"
    ]
  },
  "permissions": [
    "panels",
    "sidebar",
    "ui",
    "devtools"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "ui",
      "version": 1
    }
  ],
  "id": "forge.devtools",
  "name": "开发者工具",
  "description": "开发者调试面板：采集宿主 DOM 的 slot 锚点与常见原生选择器命中情况，查看宿主版本与能力，并可在宿主渲染进程执行调试脚本（等同于 DevTools Console）。只返回诊断数据，不上传任何内容。",
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "开发者工具",
        "entry": "panel.html"
      }
    ],
    "sidebar": [
      {
        "id": "open",
        "title": "开发者工具",
        "panel": "main"
      }
    ]
  },
  "changelog": [
    {
      "version": "0.4.2",
      "date": "2026-11-04",
      "items": [
        "随 Forge 0.4.2 更新，支持 ZIP/7z 插件安装、左栏图标及可选隔离脚本权限。"
      ]
    },
    {
      "version": "0.4.1",
      "date": "2026-11-04",
      "items": [
        "随 Forge 0.4.1 发布，保持 API 3；Nexus 改为独立导入的外部插件。"
      ]
    },
    {
      "version": "0.4.0",
      "date": "2026-11-04",
      "items": [
        "升级至 Codex Forge 0.4.0 / Forge API 3，支持增量能力协商和结构化错误。"
      ]
    },
    {
      "version": "0.3.4",
      "date": "2026-11-04",
      "items": [
        "兼容官方客户端 26.1027.6604.0，更新主页面、设置页及 Fast 适配器。",
        "随 Codex Forge 0.3.4 发布，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.3",
      "date": "2026-11-03",
      "items": [
