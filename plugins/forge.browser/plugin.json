      ]
    },
    {
      "version": "0.3.3",
      "date": "2026-11-03",
      "items": [
        "随 Codex Forge 0.3.3 发布，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.2",
      "date": "2026-11-01",
      "items": [
        "适配 Codex 26.1027.3384.0，保持 Forge API 2；修复主页面入口需要先进入设置的问题。"
      ]
    },
    {
      "version": "0.3.1",
      "date": "2026-10-28",
      "items": [
        "适配 Codex 26.1023.6123.0，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-27",
      "items": [
        "升级至 Codex Forge 0.3.0 / Forge API 2。"
