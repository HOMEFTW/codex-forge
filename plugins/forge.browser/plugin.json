{
  "schemaVersion": 1,
  "apiVersion": 1,
  "version": "0.1.0",
  "compatibility": {
    "codex": [
      "26.1016.8622.0"
    ],
    "forge": [
      ">=0.1.0 <0.2.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "changelog": [
    {
      "version": "0.1.0",
      "date": "2026-10-23",
      "items": [
        "作为 Codex Forge 内置插件提供，继承 r4 修订3 已有能力。"
      ]
    }
  ],
  "id": "forge.browser",
  "name": "内置浏览器",
  "description": "继承 r3 的内置浏览器免登录配置，通过启动参数启用 STEPS_COMMANDS 模式；不改写用户配置。",
  "contributes": {
    "settings": {
      "properties": {
        "nativeBrowserMode": {
          "type": "boolean",
          "title": "启用内置浏览器免登录配置",
          "default": true
        }
      }
    }
  },
  "restartRequired": true
}
