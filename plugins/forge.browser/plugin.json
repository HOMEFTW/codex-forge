  "id": "forge.browser",
  "name": "插件、浏览器与电脑操作",
  "description": "启用原生插件与浏览器、Windows 电脑操作支持；保留账号策略、平台限制和操作授权。",
  "contributes": {
    "settings": {
      "properties": {
        "nativeBrowserMode": {
          "type": "boolean",
          "title": "启用内置浏览器免登录配置",
          "default": true
        },
        "nativePlugins": {
          "type": "boolean",
          "title": "启用原生插件支持",
          "default": true
        },
        "externalBrowser": {
          "type": "boolean",
          "title": "启用外部浏览器操作",
          "default": true
        },
        "computerUse": {
          "type": "boolean",
          "title": "启用电脑操作",
          "default": true
        }
      }
    }
  },
  "restartRequired": true
}
