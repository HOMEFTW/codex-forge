{
  "schemaVersion": 1,
  "apiVersion": 2,
  "version": "0.3.0",
  "compatibility": {
    "codex": [
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.3.0 <0.4.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "settings",
      "version": 1
    }
  ],
  "changelog": [
    {
      "version": "0.3.0",
      "date": "2026-10-27",
      "items": [
        "升级至 Codex Forge 0.3.0 / Forge API 2。"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-24",
      "items": [
        "适配 26.1021.2667.0 适配器；免登录启动参数与 @oai 组件保持不变。"
      ]
    }
  ],
  "id": "forge.browser",
  "name": "内置浏览器",
  "description": "继承 r3 的内置浏览器免登录配置，通过启动参数启用 STEPS_COMMANDS 模式；不改写用户配置。",
  "contributes": {
    "settings": {
      "properties": {
        "nativeBrowserMode": {
          "type": "boolean",
          "title": "启用内置浏览器免登录配置",
          "default": true
        }
      }
    }
  },
  "restartRequired": true
}
