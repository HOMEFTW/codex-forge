      "26.1103.4239.0",
      "26.1029.7803.0",
      "26.1027.6604.0",
      "26.1027.3384.0",
      "26.1023.6123.0",
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.4.0 <0.6.0"
    ]
  },
  "permissions": [
    "panels",
    "settings",
    "conversation.read"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "settings",
      "version": 1
    }
  ],
  "changelog": [
    {
