{
  "$schema": "../../sdk/plugin.schema.json",
  "schemaVersion": 1,
  "apiVersion": 2,
  "id": "example.hello",
  "name": "Hello Forge",
  "version": "0.3.1",
  "description": "演示原生标签、输入框、独立存储、会话输出、浏览器和统一设置。",
  "compatibility": {
    "codex": [
      "26.1023.6123.0",
      "26.1016.8622.0",
      "26.1021.2667.0"
    ],
    "forge": [
      ">=0.3.0 <0.4.0"
    ]
  },
  "permissions": [
    "panels",
    "sidebar",
    "toolbar",
    "composer",
    "ui",
    "conversation.read",
    "conversation.title",
    "output",
    "browser",
    "storage",
    "settings"
  ],
  "capabilities": [
    {
      "name": "browser",
      "version": 1
    },
    {
      "name": "composer",
      "version": 1
    },
    {
      "name": "conversation",
      "version": 1
    },
    {
      "name": "output",
      "version": 1
    },
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "settings",
      "version": 1
    },
    {
      "name": "storage",
      "version": 1
    },
    {
      "name": "ui",
      "version": 1
    }
  ],
  "entry": "main.js",
  "contributes": {
    "slots": [
      {
        "slot": "sidebar.right.body",
        "id": "body",
        "view": "header.html"
      }
    ],
    "commands": [
      {
        "id": "hello",
        "title": "问候当前对话"
      }
    ],
    "panels": [
      {
        "id": "main",
        "title": "Hello Forge",
        "entry": "panel.html"
      }
    ],
    "sidebar": [
      {
        "id": "open",
        "title": "Hello Forge",
        "panel": "main"
      }
    ],
    "toolbar": [
      {
        "id": "hello",
        "title": "Forge 示例",
        "panel": "main"
      }
    ],
    "composer": [
      {
        "id": "greeting",
        "title": "插入问候",
        "command": "hello"
      }
    ],
    "settings": {
      "properties": {
        "greeting": {
          "type": "string",
          "title": "问候内容",
          "default": "Hello from Codex Forge!",
          "maxLength": 1000
        }
      }
    }
  },
  "changelog": [
    {
      "version": "0.3.1",
      "date": "2026-10-28",
      "items": [
        "适配 Codex 26.1023.6123.0，保持 Forge API 2。"
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-27",
      "items": [
        "升级至 Codex Forge 0.3.0 / Forge API 2。"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-24",
      "items": [
        "示例改为同时声明 26.1016.8622.0 与 26.1021.2667.0 两个客户端版本。",
        "新增 conversation.header.action UI 贡献点示例，并声明 ui 权限。"
      ]
    }
  ]
}
