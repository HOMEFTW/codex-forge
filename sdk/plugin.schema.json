{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Forge Plugin (API 1-5)",
  "type": "object",
  "required": [
    "schemaVersion",
    "apiVersion",
    "id",
    "name",
    "version",
    "compatibility",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 5
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "compatibility": {
      "type": "object",
      "required": [
        "forge"
      ],
      "properties": {
        "codex": {
          "$ref": "#/$defs/ranges",
          "description": "Optional upstream restriction. Omit when using only the Forge API (Forge 0.6.1+)."
        },
        "forge": {
          "$ref": "#/$defs/ranges"
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "panels",
          "sidebar",
          "toolbar",
          "composer",
          "ui",
          "devtools",
          "conversation.read",
          "conversation.title",
          "conversation.predict",
          "output",
          "browser",
          "storage",
          "settings",
          "network",
          "events",
          "nexus.read",
          "nexus.write",
          "dsh",
          "dsh.manage",
          "nexus.script",
          "canvas.read",
          "canvas.write",
          "todos.read",
          "todos.write",
          "skills.read",
          "skills.manage",
          "memory.read",
          "memory.write",
          "statistics.read",
          "statistics.detect",
          "collaboration.read",
          "collaboration.run",
          "conversation.history",
          "conversation.manage",
          "conversation.send",
          "conversation.events",
          "llm.call",
          "llm.providers",
          "tools.call",
          "tools.register",
          "services.call",
          "services.provide",
          "backend.node",
          "hooks.register",
          "files.read",
          "files.write",
          "shell.execute",
          "credentials.manage",
          "network.request",
          "jobs.manage",
          "schedules.manage",
          "plugins.read",
          "plugins.manage",
          "logs.read",
          "logs.write",
          "theme.read",
          "theme.write",
          "theme.register",
          "shortcuts",
          "settings.write"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "not": {
                    "enum": [
                      "canvas",
                      "todos",
                      "skills",
                      "memory",
                      "statistics",
                      "collaboration",
                      "conversation-history",
                      "conversation-management",
                      "conversation-send",
                      "conversation-events",
                      "llm",
                      "tools",
                      "services",
                      "backend",
                      "hooks",
                      "files",
                      "shell",
                      "credentials",
                      "network-request",
                      "jobs",
                      "schedules",
                      "plugins",
                      "logs",
                      "theme",
                      "shortcuts",
                      "prompt-prediction",
                      "nexus",
                      "conversation",
                      "composer",
                      "output",
                      "browser",
                      "dsh",
                      "storage",
                      "settings",
                      "events",
                      "panels",
                      "ui"
                    ]
                  }
                }
              }
            },
            "then": {
              "required": [
                "version",
                "optional"
              ],
              "properties": {
                "optional": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "entry": {
      "type": "string"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "update": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "provider",
            "repository"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+/[\\w.-]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "provider",
            "manifestUrl"
          ],
          "properties": {
            "provider": {
              "const": "server"
            },
            "manifestUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "slot",
              "id",
              "view"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "enum": [
                  "conversation.header.action",
                  "sidebar.right.body",
                  "tool.card.view",
                  "composer.leading",
                  "composer.trailing",
                  "conversation.message.action",
                  "settings.section"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][\\w-]{0,79}$"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "view": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "slot": {
                      "const": "tool.card.view"
                    }
                  }
                },
                "then": {
                  "required": ["key"]
                },
                "else": {
                  "not": {
                    "required": ["key"]
                  }
                }
              }
            ]
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "sidebar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "toolbar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "composer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/setting"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "inputSchema": {
                "type": "object"
              },
              "outputSchema": {
                "type": "object"
              },
              "scope": {
                "enum": [
                  "global",
                  "session"
                ]
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "models": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              },
              "scope": {
                "enum": [
                  "global",
                  "session"
                ]
              }
            }
          }
        },
        "services": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "methods": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][\\w-]{0,79}$"
                }
              },
              "scope": {
                "enum": [
                  "global",
                  "session"
                ]
              }
            }
          }
        },
        "jobs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][\\w-]{0,79}$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "method": {
                "type": "string",
                "pattern": "^[a-zA-Z][\\w-]{0,79}$"
              },
              "scope": {
                "enum": [
                  "global",
                  "session"
                ]
              }
            }
          }
        },
        "hooks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "llm.before",
                  "llm.after",
                  "tools.before",
                  "tools.after",
                  "conversation.beforeSend",
                  "conversation.afterSend"
                ]
              },
              "method": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              },
              "scope": {
                "enum": [
                  "global",
                  "session"
                ]
              }
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": [
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.(?:cjs|mjs|js)$"
        },
        "methods": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,79}$"
          }
        },
        "scope": {
          "enum": [
            "global",
            "session"
          ]
        }
      }
    },
    "consumes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          }
        }
      }
    }
  },
  "$defs": {
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^plugin\\.[a-z][a-z0-9.-]*\\.[a-z][a-z0-9_.:-]{0,79}$"
        },
        "title": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewBox",
            "paths"
          ],
          "properties": {
            "viewBox": {
              "const": "0 0 24 24"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^[Mm][MmZzLlHhVvCcSsQqTtAaEe0-9+.,\\s-]*$"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "panel"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ]
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entry"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "placement": {
          "enum": [
            "right",
            "expanded"
          ]
        },
        "placementReason": {
          "type": "string",
          "minLength": 6
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "expanded"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "required": [
              "placementReason"
            ]
          }
        }
      ]
    },
    "setting": {
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array"
          ]
        },
        "title": {
          "type": "string"
        },
        "default": {},
        "enum": {
          "type": "array"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "maxLength": {
          "type": "integer"
        },
        "items": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "enum": [
                "canvas.read",
                "canvas.write",
                "todos.read",
                "todos.write",
                "skills.read",
                "skills.manage",
                "memory.read",
                "memory.write",
                "statistics.read",
                "statistics.detect",
                "collaboration.read",
                "collaboration.run",
                "conversation.history",
                "conversation.manage",
                "conversation.send",
                "conversation.events",
                "llm.call",
                "llm.providers",
                "tools.call",
                "tools.register",
                "services.call",
                "services.provide",
                "backend.node",
                "hooks.register",
                "files.read",
                "files.write",
                "shell.execute",
                "credentials.manage",
                "network.request",
                "jobs.manage",
                "schedules.manage",
                "plugins.read",
                "plugins.manage",
                "logs.read",
                "logs.write",
                "theme.read",
                "theme.write",
                "theme.register",
                "shortcuts",
                "settings.write"
              ]
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "properties": {
          "apiVersion": {
            "const": 5
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "backend"
        ]
      },
      "then": {
        "properties": {
          "apiVersion": {
            "const": 5
          },
          "permissions": {
            "contains": {
              "const": "backend.node"
            }
          }
        }
      }
    }
  ]
}
