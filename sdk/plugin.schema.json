{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Forge API 1 Plugin",
  "type": "object",
  "required": ["schemaVersion","apiVersion","id","name","version","compatibility","permissions"],
  "properties": {
    "schemaVersion":{"const":1},"apiVersion":{"const":1},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "name":{"type":"string","minLength":1,"maxLength":100},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "description":{"type":"string","maxLength":20000},
    "compatibility":{"type":"object","required":["codex","forge"],"properties":{"codex":{"$ref":"#/$defs/ranges"},"forge":{"$ref":"#/$defs/ranges"}}},
    "permissions":{"type":"array","uniqueItems":true,"items":{"enum":["panels","sidebar","toolbar","composer","conversation.read","conversation.title","output","browser","storage","settings","network","events"]}},
    "entry":{"type":"string"},
    "dependencies":{"type":"object","additionalProperties":{"type":"string"}},
    "networkOrigins":{"type":"array","items":{"type":"string","format":"uri","pattern":"^https://"}},
    "update":{"oneOf":[{"type":"object","required":["provider","repository"],"properties":{"provider":{"const":"github"},"repository":{"type":"string","pattern":"^[\\w.-]+/[\\w.-]+$"}}},{"type":"object","required":["provider","manifestUrl"],"properties":{"provider":{"const":"server"},"manifestUrl":{"type":"string","format":"uri","pattern":"^https://"}}}]},
    "contributes":{"type":"object","properties":{
      "commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
      "events":{"type":"array","items":{"$ref":"#/$defs/event"}},
      "panels":{"type":"array","items":{"$ref":"#/$defs/panel"}},
      "sidebar":{"type":"array","items":{"$ref":"#/$defs/button"}},
      "toolbar":{"type":"array","items":{"$ref":"#/$defs/button"}},
      "composer":{"type":"array","items":{"$ref":"#/$defs/button"}},
      "settings":{"type":"object","properties":{"properties":{"type":"object","additionalProperties":{"$ref":"#/$defs/setting"}}}}
    }},
    "changelog":{"type":"array","items":{"type":"object","required":["version","items"],"properties":{"version":{"type":"string"},"date":{"type":"string"},"items":{"type":"array","items":{"type":"string"}}}}}
  },
  "$defs":{
    "ranges":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string"}},
    "command":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string"}}},
    "event":{"type":"object","required":["name"],"properties":{"name":{"type":"string","pattern":"^plugin\\.[a-z][a-z0-9.-]*\\.[a-z][a-z0-9_.:-]{0,79}$"},"title":{"type":"string","maxLength":100}}},
    "button":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"panel":{"type":"string"},"command":{"type":"string"}},"anyOf":[{"required":["panel"]},{"required":["command"]}]},
    "panel":{"type":"object","required":["id","title","entry"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"entry":{"type":"string"},"placement":{"enum":["right","expanded"]},"placementReason":{"type":"string","minLength":6}},"allOf":[{"if":{"properties":{"placement":{"const":"expanded"}},"required":["placement"]},"then":{"required":["placementReason"]}}]},
    "setting":{"type":"object","required":["type","title"],"properties":{"type":{"enum":["string","number","boolean"]},"title":{"type":"string"},"default":{},"enum":{"type":"array"},"minimum":{"type":"number"},"maximum":{"type":"number"},"maxLength":{"type":"integer"}}}
  }
}
