{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Forge Plugin (API 1-4)",
  "type": "object",
  "required": [
    "schemaVersion",
    "apiVersion",
    "id",
    "name",
    "version",
    "compatibility",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "default": 4
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "compatibility": {
      "type": "object",
      "required": [
        "forge"
      ],
      "properties": {
        "codex": {
          "$ref": "#/$defs/ranges",
          "description": "Optional upstream restriction. Omit when using only the Forge API (Forge 0.6.1+)."
        },
        "forge": {
          "$ref": "#/$defs/ranges"
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "panels",
          "sidebar",
          "toolbar",
          "composer",
          "ui",
          "devtools",
          "conversation.read",
          "conversation.title",
          "conversation.predict",
          "output",
          "browser",
          "storage",
          "settings",
          "network",
          "events",
          "nexus.read",
          "nexus.write",
          "dsh",
          "dsh.manage",
          "nexus.script"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "not": {
                    "enum": [
                      "conversation",
                      "composer",
                      "output",
                      "browser",
                      "storage",
                      "settings",
                      "events",
                      "panels",
                      "ui",
                      "nexus",
                      "dsh"
                    ]
                  }
                }
              }
            },
            "then": {
              "required": [
                "version",
                "optional"
              ],
              "properties": {
                "optional": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "entry": {
      "type": "string"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "update": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "provider",
            "repository"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+/[\\w.-]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "provider",
            "manifestUrl"
          ],
          "properties": {
            "provider": {
              "const": "server"
            },
            "manifestUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "slot",
              "id",
              "view"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "enum": [
                  "conversation.header.action",
                  "sidebar.right.body",
                  "tool.card.view"
                ]
              },
              "id": {
                "type": "string"
              },
              "key": {
                "type": "string",
                "maxLength": 80
              },
              "view": {
                "type": "string"
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "sidebar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "toolbar": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "composer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/setting"
              }
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "items"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ranges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^plugin\\.[a-z][a-z0-9.-]*\\.[a-z][a-z0-9_.:-]{0,79}$"
        },
        "title": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewBox",
            "paths"
          ],
          "properties": {
            "viewBox": {
              "const": "0 0 24 24"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^[Mm][MmZzLlHhVvCcSsQqTtAaEe0-9+.,\\s-]*$"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "panel"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ]
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "title",
        "entry"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "placement": {
          "enum": [
            "right",
            "expanded"
          ]
        },
        "placementReason": {
          "type": "string",
          "minLength": 6
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "expanded"
              }
            },
            "required": [
              "placement"
            ]
          },
          "then": {
            "required": [
              "placementReason"
            ]
          }
        }
      ]
    },
    "setting": {
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array"
          ]
        },
        "title": {
          "type": "string"
        },
        "default": {},
        "enum": {
          "type": "array"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "maxLength": {
          "type": "integer"
        },
        "items": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
